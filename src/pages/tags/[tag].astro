---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getSortedPosts } from "@/lib/posts";
import { getTag, getTags } from "@/lib/tags";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { tag: tag.id } }));
}

const { tag } = Astro.params;
const selectedTag = await getTag(tag);
const posts = (await getSortedPosts()).filter((post) => tag && post.data.tags?.includes(tag));
---

<BaseLayout
  title={`${selectedTag?.data.name ?? "Tag"} // Ben Rutland Web`}
  description={
    selectedTag?.data.description ??
    `Posts tagged ${selectedTag?.data.name ?? tag} on Ben Rutland Web.`
  }
>
  <div class="content-wide pt-16 pb-32">
    <div class="max-w-prose mb-8">
      <h1 class="text-4xl font-extrabold mb-8">{selectedTag?.data.name ?? "Tag"}</h1>
      {selectedTag?.data.description && <p class="text-lead">{selectedTag.data.description}</p>}
    </div>

    {posts.length ? (
      <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-y-16 gap-x-8">
        {posts.map((post) => (
          <li class="h-full">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <p>No posts found.</p>
    )}
  </div>
</BaseLayout>
