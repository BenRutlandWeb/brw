---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  class:list={[
    "button inline-flex gap-4 items-center justify-center rounded leading-3 px-4 py-2 border-2 border-transparent font-medium font-mono focus:outline-hidden focus-visible:ring-2 ring-offset-2 ring-brand-green transition focus:z-10 disabled:opacity-30 disabled:cursor-default",
    className,
  ]}
>
  <slot name="before" />
  <span class="leading-6">
    <slot />
  </span>
  <slot name="after" />
</Tag>

<style>
  .button {
    min-width: 6rem;
  }
</style>
