---
interface Props {
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : "button"}
  class:list={[
    "block rounded leading-3 p-2 focus:outline-hidden focus-visible:ring-2 transition focus:z-10 disabled:opacity-30 disabled:cursor-default",
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
