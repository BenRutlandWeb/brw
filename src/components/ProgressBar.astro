<div
  data-progress-bar
  class="content-screen sticky z-10 h-1 bg-brand-green"
></div>

<style>
  [data-progress-bar] {
    top: var(--header-height);
    transform: scaleX(0);
    transform-origin: left;
    animation-name: reading-progress;
    animation-timing-function: linear;
  }

  /* Separate rule: minifiers must not fold timeline into the animation shorthand. */
  @supports (animation-timeline: scroll()) {
    [data-progress-bar] {
      animation-timeline: scroll(root);
    }
  }

  @keyframes reading-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
