---
import { getIcon, type IconName } from "@/lib/icons";

interface Props {
  icon: IconName;
  class?: string;
}

const { icon, class: className = "fill-current inline-block w-6 h-6" } = Astro.props;
const { viewBox, inner } = getIcon(icon);
---

<svg class={className} viewBox={viewBox} fill="currentColor" aria-hidden="true" set:html={inner} />
