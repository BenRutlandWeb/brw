---
import { humanDiff } from "@/helpers/time.js";
import DoubleSlash from "@/components/DoubleSlash.astro";

interface Props {
  post: {
    meta: {
      createdAt: Date | string;
      stats: { text: string };
    };
  };
}

const { post } = Astro.props;
const createdDate = humanDiff(new Date(post.meta.createdAt));
---

<div class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-mono text-gray-600">
  <time>Posted {createdDate} ago</time>
  <span class="opacity-40"><DoubleSlash /></span>
  <span>{post.meta.stats.text}</span>
</div>
