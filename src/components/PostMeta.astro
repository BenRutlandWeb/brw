---
import { humanDiff } from "@/helpers/time.js";
import Icon from "@/components/Icon.astro";

interface Props {
  post: {
    meta: {
      createdAt: Date | string;
      stats: { text: string };
    };
  };
}

const { post } = Astro.props;
const createdDate = humanDiff(new Date(post.meta.createdAt));
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-mono text-gray-600">
  <time>Posted {createdDate} ago</time>
  <Icon icon="brw" class="fill-current inline-block size-[1em] opacity-40" />
  <span>{post.meta.stats.text}</span>
</div>
